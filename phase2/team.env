# ============================================================
#  team.env — the ONLY file you edit. Make it identical on all 4 Macs.
#  Find each Mac's IP with step 00 (00-my-network-info.command).
# ============================================================

TEAM=team1

MAC1_IP=10.7.3.72      # Mac 1: primary DNS (dnsmasq) + test client
MAC2_IP=10.7.27.22     # Mac 2: primary edge (nginx, TLS, load balancer)
MAC3_IP=10.7.2.33      # Mac 3: Backend A :3001 + BACKUP DNS (Ext A) + STANDBY EDGE (Ext E)
MAC4_IP=10.7.27.28     # Mac 4: Backend B :3002 + main test client (Wireshark)

# DNS record TTL in seconds (Phase 2 Ext B wants a short, visible TTL)
DNS_TTL=30
